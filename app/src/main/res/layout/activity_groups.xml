<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gruvbox_bg">

    <!-- Header -->
    <LinearLayout
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:background="@color/gruvbox_bg1"
        android:gravity="center_vertical"
        android:padding="12dp">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Expense Splitter"
            android:textColor="@color/gruvbox_bright_yellow"
            android:textSize="20sp"
            android:textStyle="bold"/>
        <Button
            android:id="@+id/btn_add_group"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="+ New Group"
            android:textColor="@color/gruvbox_bg"
            android:background="@drawable/btn_accent_bg"
            android:textSize="13sp"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"/>
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Your Groups"
        android:textColor="@color/gruvbox_fg2"
        android:textSize="12sp"
        android:padding="14dp"
        android:paddingBottom="4dp"/>

    <ListView
        android:id="@+id/groups_list"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:divider="@drawable/divider"
        android:dividerHeight="1dp"
        android:padding="8dp"
        android:clipToPadding="false"/>
</LinearLayout>
